# Banco de dados
DATABASE_URI=postgres://xbm:xbm@127.0.0.1:5432/xboxmania
# Segredo do Payload (gere com: openssl rand -hex 32)
PAYLOAD_SECRET=troque-este-valor
# URL pública do site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Pré-feed de notícias
CRON_SECRET=troque-este-valor
# IA para resumir notícias (opcional; sem ela o resumo é o trecho do feed, marcado para reescrita)
ANTHROPIC_API_KEY=
# Telegram (opcional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=
NOTIFY_MIN_RELEVANCE=80

# Anúncios (opcional; vazio mantém só o espaço reservado)
NEXT_PUBLIC_ADSENSE_CLIENT=

# Notícia com a sua opinião (rascunho assistido por IA)
# Modelo do redator e do verificador (padrão: claude-opus-5-5) e dos resumos em massa (padrão: claude-haiku-5-5)
WRITER_MODEL=
SUMMARY_MODEL=
# Máximo de notícias com opinião por dia
NEWS_OPINION_DAILY_LIMIT=4
# Linha de transparência no fim das notícias escritas com apoio de IA
AI_DISCLOSURE=Texto produzido com apoio de IA e revisado por Telmo Camargo.
